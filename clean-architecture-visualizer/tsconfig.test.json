{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "@types/jest"]
  },
  "include": ["src/**/*", "tests/**/*", "codemods/**/*"],
  // Replaces the inherited exclude, which skips tests/.
  "exclude": ["node_modules", "frontend", "dist"]
}
