{
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["src/components/**", "src/pages/**", "tests/unit/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "warn",
              "options": {
                "filenameCases": ["kebab-case", "PascalCase"]
              }
            }
          }
        }
      }
    }
  ]
}
